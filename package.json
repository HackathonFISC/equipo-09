{
	"name": "puente",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:api": "turbo run dev -F api --",
		"api:lint": "pnpm --filter @puente/api-spec lint",
		"api:docs": "pnpm --filter @puente/api-spec preview",
		"api:generate": "pnpm --filter web api:generate",
		"docs:dev": "pnpm --filter docs docs:dev",
		"docs:build": "pnpm --filter docs build",
		"env:generate": "varlock codegen --path ./apps/web/",
		"postinstall": "varlock codegen --path ./apps/web/",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@puente/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@11.22.0"
}
