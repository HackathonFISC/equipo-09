# Copiar a .env y completar. Nunca subir claves reales.

# --- LLM (agnóstico vía LiteLLM: el prefijo define el proveedor) ---
# Ejemplos: anthropic/claude-sonnet-5-5, openai/gpt-x, ollama/llama3
LLM_MODEL=anthropic/claude-sonnet-5-5
LLM_MODEL_FAST=anthropic/claude-haiku-5-5
LLM_API_KEY=changeme
# Respaldo si el principal falla o no valida (vacío = usa LLM_MODEL_FAST / LLM_MODEL).
# Si es de otro proveedor, define su clave estándar (p. ej. OPENAI_API_KEY).
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

# --- Base de datos ---
DATABASE_URL=sqlite:///./puente.db

# --- API ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Trazabilidad ---
# `agent_trace` (BD) siempre está activa. Langfuse es opcional: se activa solo si defines
# AMBAS claves y instalas el extra (`uv sync --extra langfuse`). Sin ellas todo funciona igual.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Por defecto NO se envía el contenido de los mensajes (CVs de jóvenes): solo modelo, latencia y tokens.
LANGFUSE_LOG_CONTENT=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
