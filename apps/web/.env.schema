# @public @type=enum(development, production, test)
NODE_ENV=development

# URL base de la API FastAPI, sin el prefijo /api/v1 (lo agrega el cliente).
# @public @type=url
NEXT_PUBLIC_API_URL=http://localhost:8000

# Datos de ejemplo derivados del contrato: auto (solo si la API no responde), siempre o nunca.
# @public @type=enum(auto, siempre, nunca)
NEXT_PUBLIC_API_MOCKS=auto
