# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# URL base de la API FastAPI, sin el prefijo /api/v1 (lo agrega el cliente).
# @public @type=url
NEXT_PUBLIC_API_URL=http://localhost:8000

# Datos de ejemplo derivados del contrato: auto (solo si la API no responde), siempre o nunca.
# @public @type=enum(auto, siempre, nunca)
NEXT_PUBLIC_API_MOCKS=auto

# URL de la API vista desde el servidor de Next (Server Components). Solo hace falta
# cuando difiere de la del navegador, p. ej. en Docker Compose: http://api:8000.
# @required=false @sensitive=false @type=url
API_INTERNAL_URL=
